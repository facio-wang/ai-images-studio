# ===== AI Images Studio 后端配置（复制为 .env 后修改）=====
# 应用
STUDIO_APP_NAME=AI Images Studio
STUDIO_HOST=0.0.0.0
STUDIO_PORT=8191
STUDIO_DEBUG=false

# 单用户鉴权 Token（前端登录页输入此 token 即登录；MCP 同用）
STUDIO_TOKEN=change-me-to-a-random-token

# 数据目录（SQLite 与资产文件；docker 中挂载卷）
STUDIO_DATA_DIR=./data

# ComfyUI 生图引擎地址
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_TIMEOUT=300

# 抠图模型：bria-rmbg（默认）| birefnet-general
REMBG_MODEL=bria-rmbg

# 任务 worker
WORKER_POLL_INTERVAL=1.0
TASK_MAX_RETRY=2
