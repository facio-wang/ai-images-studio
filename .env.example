# AI Images Studio 环境变量模板
# 复制为 .env 后按需修改：cp .env.example .env
# 注意：不要把真实 .env 提交到仓库

# 单用户 Bearer Token（登录页输入；MCP 端点鉴权同此值）——务必改成强随机串
STUDIO_TOKEN=change-me

# 容器内数据目录（SQLite + 生成资产；compose 已挂载 ./data:/app/data）
STUDIO_DATA_DIR=/app/data

# ComfyUI 生图引擎地址（宿主机上运行时用 host.docker.internal）
COMFYUI_URL=http://host.docker.internal:8188

# 服务监听端口（后端读取 STUDIO_PORT；容器内外一致，映射 8191:8191）
PORT=8191
STUDIO_PORT=8191
